# =============================================================================
# OMNICONTROL .gitignore — Repository Protection & Isolation
# =============================================================================

# Python Environments & Artifacts
agent/.venv/
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js Builds
node_modules/
apps/web/node_modules/
apps/web/.next/
apps/web/out/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local Databases, Logs & Runtime State (Preserves Environment Isolation)
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/logs/
*.log

# Sensitive Credentials, Secrets & Local Overrides
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# Operating System & IDE Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Build and Verification Temporary Captures
test_*.png
capture_*.jpg
debug_*.png
tmp/
temp/
